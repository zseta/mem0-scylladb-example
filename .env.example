GOOGLE_API_KEY=your-google-ai-studio-api-key

# ScyllaDB connection. Point SCYLLA_CONTACT_POINTS at your Docker cluster
# (default below) or at a ScyllaDB Cloud cluster's node IPs to switch targets.
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_PORT=9042
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
SCYLLA_KEYSPACE=mem0
SCYLLA_DATACENTER=
